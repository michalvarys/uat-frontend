# Build kontext posílaný do Dockeru. Bez tohohle souboru se posílá ~840 MB
# včetně node_modules a .next, které si build stejně vyrábí sám.

node_modules
.next
out

.git
.gitignore

# Lokální env soubory se do image nesmí dostat — obsahují API tokeny
# a build si hodnoty bere z build-args.
.env
.env.local
.env.*.local
.env.development

npm-debug.log*
yarn-debug.log*
yarn-error.log*

.vscode
.idea
.DS_Store

README.md
Dockerfile
.dockerignore
